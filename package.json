{
  "name": "grid-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "oxlint . --import-plugin --react-plugin --jsx-a11y-plugin --vitest-plugin --ignore-pattern build --ignore-pattern dist --ignore-pattern node_modules",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "oxfmt --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:write": "oxfmt --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "check": "bun run format && bun run lint && bun run typecheck && bun run test && bun run build",
    "db:generate": "bun --cwd apps/api drizzle:generate",
    "db:migrate": "bun --cwd apps/api drizzle:migrate",
    "mobile:check": "flutter analyze apps/energy_app && flutter test apps/energy_app && flutter analyze apps/charge_app && flutter test apps/charge_app"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.4.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.27",
    "postgres": "3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.0.3",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "playwright": "1.60.0",
    "turbo": "2.10.2",
    "typescript": "6.0.3",
    "vite": "8.1.2",
    "vitest": "4.1.9"
  },
  "packageManager": "bun@1.3.14"
}
