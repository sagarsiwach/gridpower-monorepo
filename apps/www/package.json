{
  "name": "@gridpower/www",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "preview": "react-router-serve ./build/server/index.js",
    "lint": "oxlint . --max-warnings=450",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "cf-typegen": "wrangler types",
    "deploy:preview": "react-router build && wrangler versions upload --env staging",
    "deploy:staging": "react-router build && wrangler deploy --env staging",
    "deploy:production": "react-router build && wrangler deploy",
    "release:upload": "react-router build && wrangler versions upload"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@react-router/node": "7.18.1",
    "@react-router/serve": "7.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "dialkit": "^1.3.0",
    "figma-squircle": "^1.1.0",
    "gsap": "^3.15.0",
    "isbot": "^5.1.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.15.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.18.1",
    "react-router-dom": "7.18.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@react-router/dev": "7.18.1",
    "@tailwindcss/vite": "^4.1.6",
    "@types/node": "^22.15.17",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "agentation": "^3.0.2",
    "oxlint": "^0.16.6",
    "tailwindcss": "^4.1.6",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  }
}
