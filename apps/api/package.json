{
  "name": "@grid-platform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "drizzle:migrate": "drizzle-kit migrate --config drizzle.config.ts"
  },
  "dependencies": {
    "@grid-platform/contracts": "workspace:*",
    "@grid-platform/db": "workspace:*",
    "@grid-platform/env": "workspace:*",
    "@grid-platform/observability": "workspace:*",
    "@hono/zod-openapi": "1.4.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.27",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
