{
  "name": "@gridpower/console-charge",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && wrangler types && tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "deploy:preview": "react-router build && wrangler versions upload --env staging",
    "deploy:staging": "react-router build && wrangler deploy --env staging",
    "deploy:production": "react-router build && wrangler deploy",
    "release:upload": "react-router build && wrangler versions upload",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@gridpower/tokens": "workspace:*",
    "@gridpower/ui": "workspace:*",
    "@react-router/node": "7.18.1",
    "@react-router/serve": "7.18.1",
    "cmdk": "^1.1.1",
    "isbot": "^5.1.19",
    "lucide-react": "^0.469.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.18.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@react-router/dev": "7.18.1",
    "@types/node": "^22.10.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  }
}
